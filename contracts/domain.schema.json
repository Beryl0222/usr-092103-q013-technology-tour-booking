{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "科技体验预约保障领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ELIGIBILITY_ASSERTED",
        "BUNDLE_CONFIRMED",
        "CHECKIN_RECORDED",
        "SERVICE_INTERRUPTED",
        "REFUND_ALLOCATED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "experience_product",
        "eligibility_assertion",
        "booking_bundle",
        "service_incident"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
